header.bg-white.border-b.border-gray-100.sticky.top-0.z-50.backdrop-blur-md(class="bg-opacity-90")
    .container.mx-auto.px-4.py-4.flex.justify-between.items-center
        a(href="/")
            h1.text-2xl.font-extrabold.text-center.text-indigo-600 Bienes 
                span.font-normal.text-gray-800 Raíces
        
        nav.flex.items-center.gap-6
            a.text-sm.font-medium.text-gray-500.hover_text-indigo-600.transition-colors(href="/mis-propiedades") Mis Propiedades
            a.text-sm.font-medium.text-gray-500.hover_text-indigo-600.transition-colors(href="/auth/perfil") Mi Perfil
            
            form(action="/auth/logout" method="POST" class="inline")
                input(type="hidden" name="_csrf" value=csrfToken)
                button(type="submit" class="bg-indigo-600 hover_bg-indigo-700 text-white font-semibold py-2 px-6 rounded-full text-sm transition-all shadow-md active_scale-95") Cerrar Sesión

            .flex.items-center.gap-3.ml-4.border-l.pl-6.border-gray-200
                if usuario && usuario.foto
                    img.w-10.h-10.rounded-full.object-cover.border-2.border-indigo-500.shadow-sm(src=usuario.foto alt="Foto Perfil")
                else
                    div.w-10.h-10.bg-indigo-100.rounded-full.flex.items-center.justify-center.border-2.border-indigo-200
                        span.text-indigo-600.font-bold= usuario ? usuario.nombre.charAt(0).toUpperCase() : 'U'
                
                div.hidden(class="md:block")
                    p.text-xs.text-gray-400.font-medium Matricula: 240145
                    p.text-sm.font-bold.text-gray-700= usuario ? usuario.nombre : 'Usuario'
