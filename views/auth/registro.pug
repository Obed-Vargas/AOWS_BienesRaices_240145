extends ../layout/index

block contenido 
    .py-3 
        h1.text-4xl.my-4.font-extrabold.text-center.text-indigo-600  Bienes
            span.font-normal.text-pink-500 Raíces
        h2.text-center.text-2xl.font-normal.text-gray-700 Por favor ingresa cuidadosamente tus datos

        if errores
            .max-w-md.mx-auto.my-10
                each error in errores
                    p.bg-rose-500.text-white.uppercase.text-xs.text-center.p-2.mb-1.font-bold.rounded-md= error

        .mt-8.mx-auto.max-w-xl 
            .bg-white.py-8.px-4.shadow-2xl.rounded-3xl.border-t-4.border-purple-500

                //- ── Botones de Social Login ──────────────────────────────
                .px-5.mb-6
                    p.text-center.text-sm.text-gray-400.mb-4.font-medium Regístrate rápidamente con:

                    //- Botón Google
                    a(href="/auth/google" style="text-decoration:none;" class="flex items-center justify-center gap-3 w-full border border-gray-200 rounded-xl py-3 px-4 mb-3 font-semibold text-gray-700 bg-white hover:bg-gray-50 hover:border-gray-400 hover:shadow-md transition-all duration-200 transform hover:-translate-y-0.5")
                        svg(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" width="22" height="22")
                            path(fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z")
                            path(fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z")
                            path(fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z")
                            path(fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.18 1.48-4.97 2.31-8.16 2.31-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z")
                            path(fill="none" d="M0 0h48v48H0z")
                        span Continuar con Google

                    //- Botón GitHub
                    a(href="/auth/github" style="text-decoration:none; background-color: #24292f;" class="flex items-center justify-center gap-3 w-full rounded-xl py-3 px-4 font-semibold text-white hover:shadow-md transition-all duration-200 transform hover:-translate-y-0.5")
                        svg(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="white")
                            path(d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12")
                        span Continuar con GitHub

                //- ── Separador ───────────────────────────────────────────
                .flex.items-center.px-5.mb-5
                    .flex-1.border-t.border-gray-200
                    span.px-4.text-sm.text-gray-400.font-medium.bg-white O regístrate con email
                    .flex-1.border-t.border-gray-200

                //- ── Formulario de registro ───────────────────────────────
                form.space-y-5(method="POST" action="/auth/registro" noValidate)
                    div.px-5
                        label.block.text-sm.uppercase.text-purple-600.mt-2.font-bold(for="nombreUsuario") nombre completo:
                        input#nombreUsuario.w-full.border.border-gray-200.px-3.py-2.rounded-xl.placeholder-gray-400.focus_ring-2.focus_ring-pink-400.outline-none(placeholder= "p.e.: Obed Vargas Luna" name="nombreUsuario" value = usuario ? usuario.nombreUsuario: '' type="text")

                    div.px-5
                        label.block.text-sm.uppercase.text-purple-600.mt-2.font-bold(for="emailUsuario") correo electrónico:
                        input#emailUsuario.w-full.border.border-gray-200.px-3.py-2.rounded-xl.placeholder-gray-400.focus_ring-2.focus_ring-pink-400.outline-none(placeholder= "p.e.: usuario@dominio.com" name="emailUsuario" value = usuario ? usuario.emailUsuario: '' type="email")
                    
                    //- Campo Contraseña con Ojo
                    div.px-5
                        label.block.text-sm.uppercase.text-purple-600.mt-2.font-bold(for="passwordUsuario") Contraseña:
                        .relative
                            input#passwordUsuario.w-full.border.border-gray-200.px-3.py-2.rounded-xl.placeholder-gray-400.focus_ring-2.focus_ring-pink-400.outline-none(placeholder= "Por lo menos 8 caracteres" name="passwordUsuario" type="password")
                            button.toggle-password.absolute.right-3.top-2(type="button" data-target="passwordUsuario")
                                svg#eye-icon-pass.h-6.w-6.text-gray-400(xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor")
                                    path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z")
                                    path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z")

                    //- Campo Confirmación con Ojo
                    div.px-5
                        label.block.text-sm.uppercase.text-purple-600.mt-2.font-bold(for="confirmacionUsuario") Confirmación de Contraseña:
                        .relative
                            input#confirmacionUsuario.w-full.border.border-gray-200.px-3.py-2.rounded-xl.placeholder-gray-400.focus_ring-2.focus_ring-pink-400.outline-none(placeholder= "Repite la contraseña anterior" name="confirmacionUsuario" type="password")
                            button.toggle-password.absolute.right-3.top-2(type="button" data-target="confirmacionUsuario")
                                svg#eye-icon-conf.h-6.w-6.text-gray-400(xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor")
                                    path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z")
                                    path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z")

                    div.px-5.pt-4
                        input(class= "w-full bg-gradient-to-r from-blue-500 via-purple-500 to-pink-500 text-white font-bold py-3 cursor-pointer rounded-xl shadow-lg uppercase hover:from-blue-600 hover:to-pink-600 transition-all duration-300 transform hover:-translate-y-1" type="submit" value= "Registrar Usuario")

                    div.flex.items-center.justify-between.pt-3.px-5
                        a(class="text-gray-500 text-xs hover:text-purple-600 transition" href="/auth/login") ¿Ya tienes cuenta? Inicia Sesión
                        a(class="text-gray-500 text-xs hover:text-purple-600 transition" href="/auth/recuperarPassword") ¿Olvidaste tu contraseña?

        footer.mt-12.py-8.border-t.border-gray-100
            .container.mx-auto.flex.flex-col.items-center
                p.text-gray-400.text-sm.font-bold.uppercase.tracking-widest
                    | Bienes 
                    span.text-purple-500 Raíces 
                    | &copy; #{new Date().getFullYear()}
                p.text-pink-400.text-xs.mt-2.font-medium Todos los derechos reservados por Obed Vargas Luna

    //- Script para la funcionalidad del ojo
    script.
        document.querySelectorAll('.toggle-password').forEach(button => {
            button.addEventListener('click', function() {
                const inputId = this.getAttribute('data-target');
                const input = document.getElementById(inputId);
                
                if (input.type === 'password') {
                    input.type = 'text';
                    this.classList.add('text-pink-500');
                } else {
                    input.type = 'password';
                    this.classList.remove('text-pink-500');
                }
            });
        });