extends ../layout/index

block contenido 
    .py-3
        h1.text-4xl.my-4.font-extrabold.text-center.text-indigo-600  Bienes
            span.font-normal.text-pink-500 Raíces
        h2.text-center.text-2xl.font-normal.text-gray-700 Restablece tu contraseña

        if errores
            .max-w-md.mx-auto.my-10#contenedor-errores.space-y-3
                each error in errores
                    .alerta-error.border-l-4.border-rose-500.bg-white.shadow-xl.rounded-r-lg.relative.overflow-hidden.transform.transition-all.duration-500
                        .p-4.flex.items-center
                            svg.h-6.w-6.text-rose-500.mr-3(xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor")
                                path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z")
                            p.text-sm.text-gray-700.font-bold= error.msg
                        .absolute.bottom-0.left-0.h-1.bg-rose-500.barra-tiempo(style="width: 100%; transition: width 10s linear;")

        .mt-8.mx-auto.max-w-xl 
            .bg-white.py-8.px-4.shadow-2xl.rounded-3xl.border-t-4.border-purple-500
                form.space-y-5(method="POST" noValidate)
                    input(type="hidden" name="_csrf" value=csrfToken)
                    
                    div.px-5
                        label.block.text-sm.uppercase.text-purple-600.mt-2.font-bold(for="passwordUsuario") Nueva Contraseña:
                        .relative
                            input#passwordUsuario.w-full.border.border-gray-200.px-3.py-2.rounded-xl.placeholder-gray-400.focus_ring-2.focus_ring-pink-400.outline-none(placeholder= "Ingresa tu nueva contraseña" name="passwordUsuario" type="password" required minlength="8")
                            button.toggle-password.absolute.right-3.top-2(type="button" data-target="passwordUsuario")
                                svg.h-6.w-6.text-gray-400(xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor")
                                    path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z")
                                    path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z")
                    
                    div.px-5.pt-4
                        input(class= "w-full bg-linear-to-r from-blue-500 via-purple-500 to-pink-500 text-white font-bold py-3 cursor-pointer rounded-xl shadow-lg uppercase hover:from-blue-600 hover:to-pink-600 transition-all duration-300 transform hover:-translate-y-1" type="submit" value= "Guardar Password")

        footer.mt-12.py-8.border-t.border-gray-100
            .container.mx-auto.flex.flex-col.items-center
                p.text-gray-400.text-sm.font-bold.uppercase.tracking-widest
                    | Bienes 
                    span.text-purple-500 Raíces 
                    | &copy; #{new Date().getFullYear()}
                p.text-pink-400.text-xs.mt-2.font-medium Todos los derechos reservados por Obed Vargas Luna

block scripts
    script.
        document.querySelectorAll('.toggle-password').forEach(button => {
            button.addEventListener('click', function() {
                const inputId = this.getAttribute('data-target');
                const input = document.getElementById(inputId);
                
                if (input.type === 'password') {
                    input.type = 'text';
                    this.classList.add('text-pink-500');
                } else {
                    input.type = 'password';
                    this.classList.remove('text-pink-500');
                }
            });
        });

        document.addEventListener('DOMContentLoaded', () => {
            const erroresContainer = document.querySelector('#contenedor-errores');
            if(erroresContainer) {
                const barras = erroresContainer.querySelectorAll('.barra-tiempo');
                setTimeout(() => {
                    barras.forEach(barra => {
                        barra.style.width = '0%';
                    });
                }, 50);

                setTimeout(() => {
                    const alertas = erroresContainer.querySelectorAll('.alerta-error');
                    alertas.forEach(alerta => {
                        alerta.classList.add('opacity-0', '-translate-x-full');
                    });
                    setTimeout(() => {
                        erroresContainer.remove();
                    }, 500);
                }, 10000);
            }
        });
