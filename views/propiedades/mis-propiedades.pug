extends ../layout/index

block contenido
    include ../layout/header
    .py-12
        .flex.flex-col.gap-6(class="md:flex-row md:justify-between md:items-center")
            div
                h2.text-5xl.font-black.text-gray-800.tracking-taller= pagina
                p.text-gray-400.mt-2 Gestiona tus propiedades de manera sencilla y elegante.
            
            a(href="/propiedades/crear" class="rounded-2xl bg-indigo-600 hover_bg-indigo-700 text-white text-sm font-bold uppercase py-4 px-10 transition-all shadow-xl hover_shadow-indigo-200 active_scale-95 flex items-center justify-center gap-3")
                svg(xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor")
                    path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4")
                span Publicar Nueva Propiedad

        //- Main Dashboard Area
        .mt-16
            if !propiedades
                div.bg-white.rounded-3xl.p-16.border.border-gray-50.shadow-2xl.shadow-gray-200.flex.flex-col.items-center.text-center(style="border-radius: 3rem")
                    div.w-40.h-40.bg-indigo-50.rounded-full.flex.items-center.justify-center.mb-10.animate-bounce(style="animation-duration: 3s")
                        svg(xmlns="http://www.w3.org/2000/svg" class="h-20 w-20 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor")
                            path(stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6")
                    
                    h3.text-3xl.font-black.text-gray-800 No hay propiedades aún
                    p.text-gray-400.mt-4.max-w-md.text-lg Tu catálogo está vacío. Comienza a construir tu portafolio hoy mismo.
                    
                    a(href="/propiedades/crear" class="mt-12 group flex items-center gap-3 text-indigo-600 font-bold text-lg hover_gap-5 transition-all")
                        span Crear mi primera propiedad
                        svg(xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor")
                            path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3")
            else 
                .grid.grid-cols-1(class="md:grid-cols-2 lg:grid-cols-3 gap-10")
                    //- Item list logic here

        //- Account Information (Footer Area of Content)
        .mt-24.pt-16.border-t.border-gray-100
            .flex.items-center.gap-4.mb-10
                span.h-px.bg-indigo-200.grow
                h4.text-xs.font-black.text-indigo-400.uppercase(style="letter-spacing: 0.3em") Detalles de la Cuenta
                span.h-px.bg-indigo-200.grow
            
            .grid.grid-cols-1(class="md:grid-cols-3 gap-12")
                div.group
                    p.font-black.text-indigo-300.uppercase.tracking-widest(style="font-size: 10px") Titular
                    p.mt-2.text-gray-800.font-bold.text-lg.group-hover_text-indigo-600.transition-colors= usuario ? usuario.nombre : '-'
                
                div.group
                    p.font-black.text-indigo-300.uppercase.tracking-widest(style="font-size: 10px") Identificador
                    p.mt-2.text-gray-800.font-bold.text-lg.group-hover_text-indigo-600.transition-colors= usuario ? usuario.email : '-'
                
                div.group
                    p.font-black.text-indigo-300.uppercase.tracking-widest(style="font-size: 10px") Origen
                    p.mt-2.text-gray-800.font-bold.text-lg.group-hover_text-indigo-600.transition-colors.uppercase= usuario ? (usuario.proveedor || 'Local') : 'Local'

    include ../layout/footer
